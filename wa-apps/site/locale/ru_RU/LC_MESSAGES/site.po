msgstr "Приложения"

msgid "Blocks"
msgstr "Блоки"

msgid "Only files with name extensions %s are allowed."
msgstr "Разрешена загрузка файлов только с расширениями %s."

msgid "Folder could not be created due to insufficient file write permissions for folder %s."
msgstr "Не удалось создать папку из-за недостаточных прав на перезапись содержимого папки %s."

msgid "An unknown error occurred when attempting to create a folder."
msgstr "При попытке создания папки произошла неизвестная ошибка."

msgid "Folder could not be deleted due to insufficient permissions."
msgstr "Не удалось удалить папку из-за недостаточных прав доступа."

msgid "Files could not be moved due to insufficient file write permissions for folder %s."
msgstr "Не удалось переместить файлы из-за недостаточных прав на перезапись содержимого папки %s."

msgid "Cannot move file “%s” to a new location."
msgstr "Не удалось переместить файл %s в указанную папку."

msgid "Cannot move to a new location."
msgstr "Не удалось переместить в указанную папку."

msgid "Files with name extension .%s are not allowed to security considerations."
msgstr "Файлы с расширением .%s не допускаются из соображений обеспечения безопасности."

msgid "Folder or file could not be renamed due to insufficient file write permissions for folder %s."
msgstr "Не удалось переименовать файл (папку) из-за недостаточных прав на перезапись содержимого папки %s."

msgid "File (folder) cannot be renamed."
msgstr "Не удалось переименовать файл (папку)."

msgid "Enter a new name."
msgstr "Введите новое имя."

msgid "Selected folder (file) does not exist any more."
msgstr "Выбранная папка (файл) больше не существует."

msgid "Favicon image you upload here will not take effect for your website %s, because the website is accessible in a subfolder. A favicon uploaded using the form above will be applied only to websites accessible at the domain root."
msgstr "Иконка, загруженная с помощью этой формы, не будет применена к сайту %s, потому что сайт расположен в подкаталоге домена. Загруженная через данную форму иконка может быть установлена только для сайтов, размещенных в корневом каталоге домена."

msgid "Rules you specify above for robots.txt will not take effect for you website %s, because the website is accessible in a subfolder. Rules for robots.txt entered in the form above will be effective only for websites accessible at the domain root."
msgstr "Правила для файла robots.txt, установленные с помощью этой формы, не применятся для сайта %s, потому что этот сайт расположен в подкаталоге домена. Содержимое robots.txt, добавленное с помощью этой формы, может быть использовано только для сайтов, расположенных в корневом каталоге домена."

msgid "File favicon.ico exists in the Webasyst framework installation folder. The favicon you upload here will be overridden by the existing icon file unless you delete it."
msgstr "Файл favicon.ico обнаружен в каталоге установки Webasyst. Вместо иконки, сохраненной на этой странице, будет отображаться иконка из указанного файла."

msgid "File robots.txt exists in the Webasyst framework installation folder. Rules for robots.txt you specify above will not take effect unless you delete the existing file."
msgstr "Файл robots.txt обнаружен в каталоге установки Webasyst. Правила для файла robots.txt, сохраненные на этой странице, не будут применены."

msgid "Settings could not be saved due to insufficient file write permissions for folder “%s”."
msgstr "Не удалось сохранить настройки из-за недостаточных прав на перезапись содержимого папки «%s»."

msgid "Settings could not be saved due to the insufficient file write permissions for the file \"%s\"."
msgstr "Не удалось сохранить настройки из-за недостаточных прав на запись файла «%s»."

msgid "Only files with name extension .ico are allowed."
msgstr "Допускаются только файлы с расширением *.ico."

msgid "File could not be saved due to insufficient file write permissions for folder “%s”."
msgstr "Не удалось сохранить файл из-за недостаточных прав на перезапись содержимого папки «%s»."

msgid "Failed to upload file."
msgstr "Не удалось загрузить файл."

msgid "File URL"
msgstr "URL файла"

msgid "Delete file"
msgstr "Удалить файл"

msgid "will be deleted without the ability to recover."
msgstr "будет удален без возможности восстановления."

msgid "META Keywords"
msgstr "META Keywords"

msgid "META Description"
msgstr "META Description"

msgid "Only Latin letters, numbers, and the underscore character are allowed."
msgstr "Допускается использование только латинских букв, цифр и символа подчеркивания"

msgid "This website is powered by the Site app."
msgstr "Этот сайт работает на основе приложения «Сайт»."

msgid "Refer to this tutorial to build your new site"
msgstr "Посмотрите статью документации Webasyst с примером создания сайта"

msgid "https://developers.webasyst.com/tutorials/creating-a-website-tutorial/"
msgstr "https://developers.webasyst.ru/tutorials/creating-a-website-tutorial/"

